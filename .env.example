# Copy to .env and fill in. Everything here is server-only (read by server/api.js);
# never prefix secrets with VITE_, which would bundle them into the browser.
# Without GEMINI_API_KEY the AI Advisor uses offline demo answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

DATABASE_URL=

# Live site (Vercel): add these three in Project → Settings → Environment Variables.
# "Reset demo data" is switched off there unless you also add ALLOW_RESET=true.
# ALLOW_RESET=true
